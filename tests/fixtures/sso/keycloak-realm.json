    { "username": "bob", "enabled": true, "email": "bob@example.test", "emailVerified": true, "firstName": "Bob", "lastName": "Example",
      "credentials": [{ "type": "password", "value": "synthetic-bob-pass-1", "temporary": false }], "groups": ["/guests"] },
    { "username": "rita", "enabled": true, "email": "rita@example.test", "emailVerified": true, "firstName": "Rita", "lastName": "Example",
      "credentials": [{ "type": "password", "value": "synthetic-rita-pass-1", "temporary": false }], "groups": ["/staff", "/jacarium-admins"] },
    { "username": "carol", "enabled": true, "email": "carol@example.test", "emailVerified": true, "firstName": "Carol", "lastName": "Example",
      "credentials": [{ "type": "password", "value": "synthetic-carol-pass-1", "temporary": false }], "groups": ["/staff"] },
    { "username": "adminsso", "enabled": true, "email": "adminsso@example.test", "emailVerified": true, "firstName": "Site", "lastName": "Admin",
