{
  "name": "jacarium",
  "private": true,
  "version": "3.7.1",
  "description": "Everything you know and use for technical work, in one place.",
  "homepage": "https://jacarium.com",
  "desktopName": "com.jacarium.app.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/jacarium/jacarium"
  },
  "license": "AGPL-3.0-only",
  "funding": [
    {
      "type": "individual",
      "url": "https://ko-fi.com/robincernin"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/zerodayz"
    }
  ],
  "author": {
    "name": "Robin Cernin",
    "email": "support@example.com",
    "url": "https://github.com/zerodayz"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "bash scripts/build-ui.sh",
    "lint": "eslint . --max-warnings 0",
    "vendor": "node scripts/vendor-assets.mjs",
    "postinstall": "node scripts/vendor-assets.mjs",
    "preview": "vite preview",
    "release": "node scripts/release.cjs",
    "release:tag": "node scripts/release.cjs tag",
    "vex": "backend/venv/bin/python scripts/vex.py",
    "deps:urgent": "node scripts/urgent-dep-update.cjs",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "backend:build": "cd backend && bash build_backend.sh",
    "electron:build": "npm run build && electron-builder",
    "electron:build:full": "npm run backend:build && npm run build && electron-builder"
  },
  "build": {
    "appId": "com.jacarium.app",
    "productName": "Jacarium",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icons/**/*",
      "build-mode.cjs",
      "package.json",
      "protocol.json"
    ],
    "extraResources": [
      {
        "from": "backend/dist/flask-backend",
        "to": "flask-backend"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icons/icon.icns"
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icons/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icons",
      "executableName": "jacarium",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "GenericName": "Notes, cases and tools",
          "Keywords": "notes;documents;cases;tasks;taskwarrior;jira;kanban;",
          "StartupNotify": "true"
        }
      }
    },
    "rpm": {
      "fpm": [
        "--rpm-rpmbuild-define=_build_id_links none"
      ]
    }
  },
  "dependencies": {
    "asn1js": "^3.0.10",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dexie": "^4.3.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "he": "^1.2.0",
    "highlight.js": "^11.12.0",
    "iban": "^0.0.14",
    "js-yaml": "^4.2.0",
    "jsbarcode": "^3.12.3",
    "jszip": "^3.10.1",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.577.0",
    "marked": "^18.1.1",
    "mermaid": "^12.0.0",
    "node-fetch": "^3.3.2",
    "pdf-lib": "^1.17.1",
    "pkijs": "^3.4.1",
    "prettier": "^3.8.3",
    "qrcode": "^1.5.4",
    "quicktype-core": "^26.0.0",
    "react": "^19.2.0",
    "react-colorful": "^5.7.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "reactflow": "^11.11.4",
    "socket.io-client": "^4.8.3",
    "turndown": "^7.2.4",
    "xml2js": "^0.6.2",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@fontsource/red-hat-mono": "^5.3.0",
    "@fontsource/red-hat-text": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@fortawesome/fontawesome-free": "^5.15.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "chart.js": "^4.5.1",
    "concurrently": "^8.2.2",
    "electron": "^42.11.16",
    "electron-builder": "^26.15.7",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "pdfjs-dist": "^6.3.289",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.6",
    "wait-on": "^7.2.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "follow-redirects": "^1.16.2",
    "global-agent": "^4.1.3",
    "katex": "^0.18.2",
    "lodash-es": "^4.18.1",
    "postcss-selector-parser": "^7.1.6",
    "qs": "^6.16.0",
    "node-gyp": {
      "undici": "^6.29.1"
    },
    "@electron/get": {
      "undici": "^7.30.1"
    },
    "zod": "^4.6.6",
    "fast-uri": "^3.1.9",
    "joi": "^17.13.9"
  }
}
