# Caddy in front of the Jacarium backend (deploy/Containerfile).
#
# One origin for everything: the built UI is served from /app/ui and every
# other path is forwarded to Flask on 127.0.0.1:8080 inside the container,
# which is the only way to reach it (JACARIUM_AUTH_MODE=none: the
# backend trusts the proxy, so the proxy must stay the only entry point).
#
# No sign-in: anyone who can reach the published port can use the app and
# the SSH / Taskwarrior / settings APIs. Bind it to 127.0.0.1 or a trusted
# network only (deploy/deploy-podman.sh refuses 0.0.0.0 unless asked).
# (With JACARIUM_AUTH_MODE=accounts the backend itself asks for a sign-in.)

{
	admin off
	auto_https off
}

https://:{$HTTPS_PORT:8443} {
	tls {$TLS_CERT_FILE:/data/certs/cert.pem} {$TLS_KEY_FILE:/data/certs/key.pem}

	encode gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}

	# The central server (the team features, jacarium-central) behind this
	# origin: /central/* is forwarded, prefix stripped, to the central
	# server the entrypoint runs in this container on loopback
	# (CENTRAL_UPSTREAM, 127.0.0.1:3000; or one running elsewhere). One
	# hostname and certificate for the app and the central server,
	# websockets included; a signed-in user is recognised there by a ticket
	# of this server. The cross-site guard applies here too, with one
	# exception: the desktop app's renderer runs from file:// and its
	# WebSocket handshake carries "Origin: file://", which no web page can
	# send. entrypoint.sh removes this block with JACARIUM_CENTRAL=off.
	# >>> central
	handle_path /central/* {
		@foreignCentral {
			header_regexp Sec-Fetch-Site ^(cross-site|same-site)$
			not header Sec-Fetch-Mode navigate
			not header Origin file://
		}
		handle @foreignCentral {
			respond "Cross-site requests are not accepted" 403
		}
		handle {
			reverse_proxy {$CENTRAL_UPSTREAM} {
				flush_interval -1
				transport http {
					read_timeout 10m
					write_timeout 10m
				}
			}
		}
	}
	# <<< central

	# A page on another site (or another port of this host) must not be
	# able to drive the unauthenticated API with the viewer's browser.
	# Browsers label such requests cross-site / same-site; navigations
	# (a link to the app) are still allowed, and tools like curl send no
	# Sec-Fetch-* headers at all.
	@foreign {
		header_regexp Sec-Fetch-Site ^(cross-site|same-site)$
		not header Sec-Fetch-Mode navigate
	}
	handle @foreign {
		respond "Cross-site requests are not accepted" 403
	}

	# The single-page app and its static files (the Vite build output).
	#
	# Caching: index.html and the other unhashed files are revalidated on
	# every load (no-cache: the browser keeps a copy but asks first), while
	# the hashed /assets/* files are immutable for a year. Without that a
	# browser could keep an old index.html by heuristic and ask for chunks
	# the new image no longer has ("Importing a module script failed").
	# The hashed files are served from the data volume, where entrypoint.sh
	# keeps the previous build's files next to the current ones for one
	# deploy, so a tab that was open during a redeploy keeps working.
	# The single-page app's entry, the hashed assets (served from the data
	# volume, see above) and the media / quizData directories:
	root * /app/ui
	@ui {
		path / /index.html /assets/* /media/* /quizData/*
	}
	# ...and every other FILE of the build under /app/ui - what Vite copied
	# from public/: favicon.ico/.png/.svg, apple-touch-icon.png, the web
	# manifest, icon-*.png, brand/* - matched by existence, so a new icon
	# needs no entry here. Static files are public; the sign-in gate is the
	# backend's, for the API. A path that is not a file (the API, /health,
	# Socket.IO, an unknown route) goes to Flask below, as before.
	@static {
		not path /api/* /socket.io/* /health /assets/*
		file {path}
	}
	handle @static {
		@manifest path /manifest.webmanifest
		header @manifest Content-Type application/manifest+json
		header Cache-Control "no-cache"
		file_server
	}
	handle @ui {
		@hashed path /assets/*
		@unhashed not path /assets/*
		header @unhashed Cache-Control "no-cache"
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		handle @hashed {
			root * /data/ui-assets
			file_server
		}
		file_server
	}

	# Everything else is the backend (REST + Socket.IO, websockets included).
	handle {
		reverse_proxy 127.0.0.1:8080 {
			flush_interval -1
			transport http {
				read_timeout 10m
				write_timeout 10m
			}
		}
	}
}
