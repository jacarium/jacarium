# Jacarium in a browser: one UBI 9 image with the built UI, the
# Flask backend under gunicorn, the central server (jacarium-central/, the
# team features: Node) behind /central, and Caddy in front (HTTPS, same
# origin) - one container, one volume.
#
#   podman build -f deploy/Containerfile -t jacarium:latest .
#   deploy/deploy-podman.sh            (build + run; see docs/SELF_HOSTING.md)
#
# Everything that must survive a restart lives on the /data volume: the
# accounts database, every account's own files under users/<id> (settings,
# Taskwarrior data, SSH known_hosts and identities, the RAG index, reports),
# the server-default settings (settings.env), the TLS certificate and the shared sosreports / must-gathers that
# Diagnostics browses (reports/), and the central server's state under
# central/ (its client registry and encrypted Yjs snapshots in central/data,
# the Yjs encryption key and the account-ticket key in central/keys - both
# generated on first start when missing). The app's own documents, tasks,
# kanban boards etc. stay in the browser's IndexedDB (one database per
# account), as on the desktop.
#
# JACARIUM_AUTH_MODE=accounts (the default): sign-in required; the
# first start prints a one-time setup code (also /data/setup-code) that
# creates the administrator. JACARIUM_AUTH_MODE=none: the earlier
# open deployment - one shared set of files, anyone who can reach the port.
#
# Base images are pinned by digest. The versions chosen were published at
# least a week before this file was written (the same release-age rule
# .npmrc applies to npm packages).

# ---------------------------------------------------------------------------
# UI build (Vite) - node 24.22.1 (2026-10-20, a security release: CVE-2026-111497 in the bundled brotli; image 2026-10-28, approved cooldown exception)
# ---------------------------------------------------------------------------
FROM docker.io/library/node:24.22.1-bookworm-slim@sha256:be8204d4bd327363357f532187b752ff62759c31bedf98e9e18fc08c9cbd605c AS ui
WORKDIR /src
# bash: scripts/build-ui.sh; git: optional for the What's New page
RUN apt-get update \
 && apt-get install -y --no-install-recommends bash git ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json .npmrc ./
COPY scripts ./scripts
# postinstall copies the vendored assets into backend/static/vendor
RUN mkdir -p backend/static && npm ci --no-audit --no-fund
COPY . .
RUN npm run build
# The central server's production dependencies, exactly the locked versions
# (its own lock file; .npmrc's release-age rule applies here too).
RUN cd jacarium-central && npm ci --omit=dev --no-audit --no-fund
# Project label (last, so it costs no cached layer): the untagged image a
# stage leaves behind carries only its own labels, and deploy/prune-images.sh
# removes superseded ones by this label - never anything else on the machine.
LABEL com.jacarium.image=deploy com.jacarium.stage=ui

# ---------------------------------------------------------------------------
# Taskwarrior 2.6.2 from source: EPEL 9 does not carry it, and the backend
# is verified against 2.6 (the version Debian / Ubuntu ship). Built on the
# same ubi9-minimal the runtime stage uses, with the toolchain from the UBI
# repos (tar for the tarball: minimal does not carry it).
# ---------------------------------------------------------------------------
FROM registry.access.redhat.com/ubi9-minimal:9.8-1792742033@sha256:2d4c4551af6831dcd26bbf86108c4385de5183ec8fe6b5868f6f9640fe47f4ed AS taskwarrior
RUN microdnf -y --setopt=install_weak_deps=0 --nodocs install tar gzip gcc-c++ cmake make libuuid-devel \
 && microdnf clean all
WORKDIR /build
ARG TASKWARRIOR_VERSION=2.6.2
ARG TASKWARRIOR_SHA256=b1d3a7f000cd0fd60640670064e0e001613c9e1cb2242b9b3a9066c78862cfec
RUN curl -fsSL -o task.tar.gz "https://github.com/GothenburgBitFactory/taskwarrior/releases/download/v${TASKWARRIOR_VERSION}/task-${TASKWARRIOR_VERSION}.tar.gz" \
 && echo "${TASKWARRIOR_SHA256}  task.tar.gz" | sha256sum -c - \
 && tar xzf task.tar.gz \
 && cd "task-${TASKWARRIOR_VERSION}" \
 && cmake -DCMAKE_BUILD_TYPE=release -DENABLE_SYNC=OFF -DCMAKE_INSTALL_PREFIX=/opt/taskwarrior . \
 && make -j"$(nproc)" \
 && make install
LABEL com.jacarium.image=deploy com.jacarium.stage=taskwarrior

# ---------------------------------------------------------------------------
# Caddy 2.11.7, built here: the published Caddy binary carries Go 1.26.8 and
# golang.org/x/net 0.59.0, with eleven open Go advisories against the
# HTTP/2 server (GO-2026-6603..6617, see vex/decisions.yaml), and no upstream
# release built with a fixed toolchain exists yet. So the same Caddy 2.11.7
# source and module set (what xcaddy would assemble: caddy/v2's cmd and
# modules/standard) is compiled on the official golang image, Go 1.27.2
# (2026-10-02; the image 2026-10-10), with golang.org/x/net raised to 0.62.0
# (2026-10-27: its html package's GO-2026-6860 and GO-2026-6866 fixes; two
# days old when pinned, under the user's exception -
# docs/security/urgent-updates.md).
# The modules come from the Go module proxy and are checked against the Go
# checksum database (GOSUMDB, on by default). A static, trimmed, VCS-free
# build: the binary is reproducible from these inputs. `caddy build-info`
# in the image shows the toolchain and x/net versions.
# ---------------------------------------------------------------------------
FROM docker.io/library/golang:1.27.2-alpine@sha256:f92b6ef800e499660581efdabdf25d9d817a9d124eaf900924f0504e7e27e12d AS caddy
ARG CADDY_VERSION=v2.11.7
ARG XNET_VERSION=v0.62.0
# go-chi/chi v5.4.0 (2026-10-12): GHSA-j6qf-3m9c-vwj3, reported against the v5.3.2 Caddy 2.11.7 pulls in
ARG CHI_VERSION=v5.4.0
# go-jose/v4 v4.1.6 (2026-10-14; sum.golang.org record 69076000): GHSA-mgcc-cww5-fp2q (CVE-2026-116587,
# a denial of service through unbounded RSA JWK sizes), reported against the v4.1.5 Caddy 2.11.7 pulls in
ARG GOJOSE_VERSION=v4.1.6
WORKDIR /build
ENV CGO_ENABLED=0 GOFLAGS=-mod=mod GOTOOLCHAIN=local
RUN printf '%s\n' 'package main' '' 'import (' '	caddycmd "github.com/caddyserver/caddy/v2/cmd"' '' '	_ "github.com/caddyserver/caddy/v2/modules/standard"' ')' '' 'func main() {' '	caddycmd.Main()' '}' > main.go \
 && go mod init caddy-build \
 && go get "github.com/caddyserver/caddy/v2@${CADDY_VERSION}" \
 && go get "golang.org/x/net@${XNET_VERSION}" \
 && go get "github.com/go-chi/chi/v5@${CHI_VERSION}" \
 && go get "github.com/go-jose/go-jose/v4@${GOJOSE_VERSION}" \
 && go mod tidy \
 && go build -trimpath -buildvcs=false -ldflags '-s -w' -o /usr/bin/caddy . \
 && /usr/bin/caddy version \
 && /usr/bin/caddy build-info | grep -E "^(go|dep\s+golang.org/x/net|dep\s+github.com/go-chi/chi/v5|dep\s+github.com/go-jose/go-jose/v4)\s" \
 && /usr/bin/caddy build-info | grep -qE "^dep\s+golang.org/x/net\s+${XNET_VERSION}\s" \
 && /usr/bin/caddy build-info | grep -qE "^dep\s+github.com/go-chi/chi/v5\s+${CHI_VERSION}\s" \
 && /usr/bin/caddy build-info | grep -qE "^dep\s+github.com/go-jose/go-jose/v4\s+${GOJOSE_VERSION}\s"

# ---------------------------------------------------------------------------
# Runtime - ubi9-minimal 9.8-1792742033 (2026-10-23, RHEL 9.8, with the
# ca-certificates 2026.2.92 fix for CVE-2026-114406): 112 MB and 109 RPMs,
# without the system Python 3.9, dnf, python3-urllib3, brotli and the s2i
# tooling that ubi9/python-314 carried and nothing in the image ran - the
# packages the scanners kept reporting. Red Hat's Python 3.14 (python3.14:
# the same minor version as the desktop venv, so backend/requirements.lock
# is one set of wheels for both) and the few runtime packages come from the
# UBI repositories through microdnf, which checks Red Hat's RPM signatures;
# sshpass is in ubi-9-appstream-rpms, so no EPEL. OS fixes land with a
# base-image bump (no blanket update in the build: the image stays
# reproducible from the pinned digest); the one package raised past the base
# is xz-libs (5.2.5-8.el9_8.1 for CVE-2026-34743, which the sos report
# parser reaches through Python's lzma module - the user's exception,
# docs/security/urgent-updates.md). The base build is seven days old from
# 2026-10-30, the earliest day a release carries it.
# ---------------------------------------------------------------------------
FROM registry.access.redhat.com/ubi9-minimal:9.8-1792742033@sha256:2d4c4551af6831dcd26bbf86108c4385de5183ec8fe6b5868f6f9640fe47f4ed
LABEL org.opencontainers.image.title="Jacarium" \
      org.opencontainers.image.description="Jacarium UI + backend behind Caddy (HTTPS)" \
      org.opencontainers.image.url="https://jacarium.com"

# python3.14 and the pip wheel that bootstraps the venv's pip (no system
# pip, so no second vendored urllib3 in the image); openssh-clients: the
# workflow SSH node runs the ssh binary; sshpass for password logins;
# openssl generates the self-signed certificate. What carries the build's
# time is removed - microdnf's cache and metadata, the dnf history and the
# hawkey log, ldconfig's aux-cache (the scriptlets' ldconfig run records
# inode numbers and times in it; the loader does not need it): the layer
# then differs between two builds of the same commit only by the rpm
# database's install times (docs/security/reproducible-builds.md). The last line makes sure none of
# the packages this base was chosen to be rid of came back as a dependency.
RUN microdnf -y --setopt=install_weak_deps=0 --nodocs install python3.14 python3.14-pip-wheel openssh-clients sshpass openssl \
 && microdnf -y --setopt=install_weak_deps=0 --nodocs upgrade xz-libs \
 && rpm -q xz-libs-5.2.5-8.el9_8.1 \
 && test "$(rpm -q python3 python3-libs python3-urllib3 python3-pip libbrotli brotli brotli-devel dnf nodejs npm 2>&1 | grep -vc 'is not installed')" = 0 \
 && microdnf clean all \
 && rm -rf /var/cache/yum /var/cache/dnf /var/log/dnf* /var/log/hawkey.log /var/lib/dnf/history.sqlite* /var/log/rhsm /var/lib/dnf/repos/*/countme /var/cache/ldconfig/aux-cache

# The unprivileged user the image runs as (uid 1001, gid 0 - what
# ubi9/python-314 called "default"; ssh needs a passwd entry for the uid it
# runs under), its home on the volume; the application's venv at
# /opt/app-root as before, first on PATH (python, pip and gunicorn resolve
# to it) and made without pip, which the pip layer below installs from the
# wheel at its pinned version; python3 for anyone who execs into the
# container. The locale: minimal ships C.UTF-8 only, which Python 3.14 and
# everything here are content with.
RUN printf 'default:x:1001:0:Default Application User:/data:/sbin/nologin\n' >> /etc/passwd \
 && ln -s /usr/bin/python3.14 /usr/bin/python3 \
 && python3.14 -m venv --without-pip /opt/app-root
ENV PATH=/opt/app-root/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    VIRTUAL_ENV=/opt/app-root \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=UTF-8 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

COPY --from=caddy /usr/bin/caddy /usr/local/bin/caddy
COPY --from=taskwarrior /opt/taskwarrior/bin/task /usr/local/bin/task
# Node for the central server: the official binary the UI build stage runs
# (nodejs.org builds depend on glibc >= 2.28 and libstdc++ only, both in
# UBI 9), the same Node 24 the desktop build uses.
COPY --from=ui /usr/local/bin/node /usr/local/bin/node

WORKDIR /app
# requirements.lock pins every package to the versions the desktop venv and
# the PyInstaller build use (backend/lock-requirements.sh regenerates it).
COPY backend/requirements.txt backend/requirements.lock /app/backend/
# pip pinned (26.2.1, 2026-08-04; the seven-day rule like every other
# version here) rather than "whatever is newest at build time": the pip of
# Red Hat's wheel (run straight from the .whl, nothing of it installed) puts
# exactly that version into the venv. --no-compile, then hash-based
# bytecode: a .pyc compiled at install time embeds the source's modification
# time, so two builds of the same commit differed; unchecked-hash .pyc files
# carry a hash of the source instead and are never re-validated, which an
# immutable image does not need (docs/security/reproducible-builds.md)
RUN w="$(ls /usr/share/python3.14-wheels/pip-*.whl)" \
 && python "$w/pip" install --no-cache-dir --no-compile 'pip==26.2.1' \
 && pip install --no-cache-dir --no-compile -r /app/backend/requirements.txt -c /app/backend/requirements.lock \
 && python -m compileall -q -f --invalidation-mode unchecked-hash /opt/app-root/lib/python3.14/site-packages /opt/app-root/lib64/python3.14/site-packages

COPY backend /app/backend
# the version the server reports (package.json) and the protocol it speaks (protocol.json)
COPY package.json protocol.json /app/
COPY --from=ui /src/backend/static/vendor /app/backend/static/vendor
COPY --from=ui /src/dist /app/ui
# the central server (jacarium-central/: its own Node project, unchanged)
# and its production node_modules from the build stage
COPY jacarium-central /app/central
COPY --from=ui /src/jacarium-central/node_modules /app/central/node_modules
COPY deploy/Caddyfile /app/Caddyfile
COPY deploy/entrypoint.sh /app/entrypoint.sh
RUN chmod 0755 /app/entrypoint.sh \
 && mkdir -p /data \
 && chown -R 1001:0 /app /data \
 && chmod -R g=u /app /data

USER 1001
ENV HOME=/data \
    PORT=8080 \
    JACARIUM_AUTH_MODE=accounts \
    JACARIUM_ENV_FILE=/data/.jacarium.env \
    JACARIUM_REPORTS_ROOT=/data/reports \
    JACARIUM_KNOWN_HOSTS=/data/.ssh/known_hosts \
    TLS_CERT_FILE=/data/certs/cert.pem \
    TLS_KEY_FILE=/data/certs/key.pem \
    HTTPS_PORT=8443
# The central server runs inside this container on 127.0.0.1:3000 and Caddy
# forwards /central/* to it (deploy/entrypoint.sh starts and supervises it,
# generates its keys under /data/central/keys on first start and hands the
# account-ticket key to the backend). JACARIUM_CENTRAL=off runs the
# container without it (no /central route, no team features);
# CENTRAL_UPSTREAM=host:port forwards /central to a central server running
# elsewhere instead of the embedded one (the 3.1 two-container shape).

VOLUME ["/data"]
EXPOSE 8443
# Unhealthy when EITHER the console or the central server behind it is down
# (the entrypoint keeps the central route only while the central server is
# expected, so the second check is skipped when it is switched off).
HEALTHCHECK --interval=30s --timeout=8s --start-period=30s --retries=3 \
  CMD curl -fsk "https://127.0.0.1:${HTTPS_PORT}/health" >/dev/null \
   && { [ ! -f /tmp/central.expected ] || curl -fsk "https://127.0.0.1:${HTTPS_PORT}/central/api/health" >/dev/null; } || exit 1

LABEL com.jacarium.image=deploy com.jacarium.stage=app
ENTRYPOINT ["/app/entrypoint.sh"]
